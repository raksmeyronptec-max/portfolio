{
  "name": "ron-raksmey-portfolio-cms",
  "version": "2.0.0",
  "private": true,
  "description": "Bilingual (Khmer/English) personal portfolio CMS for Ron Raksmey — educator, mathematics student and full-stack product builder.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "bash scripts/run-rls-tests.sh",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "capture:about": "node scripts/capture-about-screenshots.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:seed": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "heic-decode": "^2.1.0",
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "supabase": "^2.110.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  }
}
