# ─────────────────────────────────────────────────────────────────────────────
#  Ron Raksmey Portfolio CMS — environment variables
#
#  Copy to `.env.local` for local development and set the same keys in the
#  Netlify UI (Site configuration → Environment variables) for production.
#
#  NEVER commit `.env.local`. NEVER add the service-role key to any variable
#  whose name starts with NEXT_PUBLIC_ — that prefix ships the value to the
#  browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public site ──────────────────────────────────────────────────────────────
# Absolute origin, no trailing slash. Used for canonical URLs, hreflang,
# Open Graph URLs, the sitemap and JSON-LD @id values.
NEXT_PUBLIC_SITE_URL=https://portfolio-ron-raksmey.netlify.app

# ── Supabase (public — safe to expose) ───────────────────────────────────────
# Project API URL and the anon/publishable key. The anon key is designed to be
# public; every table it can reach is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ── Supabase (secret — server only) ──────────────────────────────────────────
# Bypasses RLS. Required only for: signing URLs for private certificate
# originals, writing audit logs, and admin role lookups. Used exclusively in
# Server Components, Server Actions and route handlers.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ── Contact form notifications (optional) ────────────────────────────────────
# Messages are always persisted to the database first; Telegram is a best-effort
# notification on top. If these are unset, the form still works and the UI does
# not claim a notification was delivered.
#
# ⚠️  The v1 codebase hardcoded a live bot token in
#     netlify/functions/contact.js. That token is compromised and must be
#     revoked and regenerated in @BotFather before use.
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_CHAT_ID=

# ── Ask-Ron chat widget (optional, legacy) ───────────────────────────────────
# Server-side only. Leave empty to disable the widget entirely.
GEMINI_API_KEY=

# ── Contact form abuse controls ──────────────────────────────────────────────
CONTACT_COOLDOWN_SECONDS=120
CONTACT_MAX_PER_HOUR=3

# ── Local Supabase CLI development ───────────────────────────────────────────
# `supabase start` prints these. Only needed for integration tests against the
# local stack.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── End-to-end test credentials (local/CI only) ──────────────────────────────
# An owner-role account seeded in the test database. Never point these at
# production.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
