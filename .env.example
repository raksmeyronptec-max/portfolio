# ─────────────────────────────────────────────────────────────────────────────
#  Ron Raksmey Portfolio CMS — environment variables
#
#  Copy to `.env.local` for local development, and set the same keys in your
#  host's dashboard for production — on Vercel that is Project → Settings →
#  Environment Variables.
#
#  NEVER commit `.env.local`. NEVER add the service-role key to any variable
#  whose name starts with NEXT_PUBLIC_ — that prefix ships the value to the
#  browser bundle.
#
#  Every value below is a placeholder. Real credentials belong only in
#  `.env.local` (git-ignored) and in the host's dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public site ──────────────────────────────────────────────────────────────
# Absolute origin, no trailing slash. Used for canonical URLs, hreflang,
# Open Graph URLs, the sitemap and JSON-LD @id values.
#
# Set this to your real domain in production. If it is unset, siteUrl() falls
# back to the host's own variable (VERCEL_PROJECT_PRODUCTION_URL on Vercel,
# URL on Netlify) — which works, but means the canonical host is whatever the
# platform assigned rather than a domain you chose. Set it explicitly once you
# have a custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ── Supabase (public — safe to expose) ───────────────────────────────────────
# Project API URL and the anon/publishable key. The anon key is designed to be
# public; every table it can reach is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ── Supabase (secret — server only) ──────────────────────────────────────────
# Bypasses RLS. Required only for: signing URLs for private certificate
# originals, writing audit logs, and admin role lookups. Used exclusively in
# Server Components, Server Actions and route handlers.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ── Contact form notifications (optional) ────────────────────────────────────
# Messages are always persisted to the database first; Telegram is a best-effort
# notification on top. If these are unset, the form still works and the UI does
# not claim a notification was delivered.
#
# ⚠️  The v1 codebase hardcoded a live bot token in
#     netlify/functions/contact.js. That token is compromised and must be
#     revoked and regenerated in @BotFather before use.
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_CHAT_ID=

# ── Ask-Ron chat widget (optional, legacy) ───────────────────────────────────
# Server-side only. Leave empty to disable the widget entirely.
GEMINI_API_KEY=

# ── Contact form abuse controls ──────────────────────────────────────────────
CONTACT_COOLDOWN_SECONDS=120
CONTACT_MAX_PER_HOUR=3

# ── Local Supabase CLI development ───────────────────────────────────────────
# `supabase start` prints these. Only needed for integration tests against the
# local stack.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── End-to-end test credentials (local/CI only) ──────────────────────────────
# An owner-role account seeded in the test database. Never point these at
# production.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# ── Cloudflare R2 object storage ─────────────────────────────────────────────
#  Where uploaded images and PDFs are stored. When these are set, new uploads go
#  to R2; when they are not, uploads fall back to Supabase storage. Both are
#  read at the same time, so files uploaded before the switch keep working —
#  each media_assets row records which backend holds it.
#
#  TWO BUCKETS, and the split is not optional. R2 has no per-object access
#  control: enabling a custom domain or the public development URL makes every
#  object in that bucket world-readable by key. Certificate scans can carry a
#  national ID number, so they live in a separate bucket that has no public URL
#  at all and is reached only by a short-lived signed request.
#
#    R2_BUCKET_NAME          public   — needs a custom domain or the public
#                                       development URL ENABLED, or images 401
#    R2_PRIVATE_BUCKET_NAME  private  — must NEVER be given either one
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Defaults to "<R2_BUCKET_NAME>-private" when unset.
R2_PRIVATE_BUCKET_NAME=

# Public origin serving the public bucket only — the r2.dev development URL or
# your own custom domain. No trailing slash. Safe to expose: it is a host name.
NEXT_PUBLIC_R2_PUBLIC_URL=
